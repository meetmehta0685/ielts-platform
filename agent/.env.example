LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=ielts-examiner

# LiveKit Inference uses the LiveKit project credentials for the default
# STT/LLM/TTS pipeline. Provider-specific keys can be added later if needed.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley
