PORT=8000

# Supabase project (Settings → API). The service role key stays on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI marking walks a chain: each Groq model (about 1,000 free requests a day each), then
# OpenRouter's free models (50 a day in total). Groq also transcribes speech with Whisper.
GROQ_API_KEY=your-groq-key
GROQ_MODELS=
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODELS=

# Optional examiner voice. Without it the browser's speech synthesis is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# AI examiner room for the full-exam simulator (shared with agent/).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=ielts-examiner

# Optional comma-separated list of allowed browser origins (defaults to all).
CORS_ORIGIN=
